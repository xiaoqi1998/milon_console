README.md
API.md
_*.ps1
_*.py
_*.txt
docker-compose.yml
Dockerfile
.dockerignore

# 运行时数据（saved instructions 等，容器内自行生成）
data/

# 本地调试产物与历史备份（不入构建上下文）
gosdk-develop-backup-*/
*.log
*.err

# 本地密钥与测试数据（防止私钥进入构建上下文）
audit_keys/
fndsa_*
sft_1000_testdata.json
